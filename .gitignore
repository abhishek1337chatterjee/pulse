# local DBs (data, not code)
*.duckdb
*.duckdb.wal
*.duckdb.tmp/

# generated dashboards write to /tmp/. Defend against ever landing
# a generated HTML in the repo, EXCEPT for the docs/ tree which is
# the canonical hand-written internals doc site.
*.html
!docs/*.html

# editor / OS noise
.DS_Store
*.bak
*.bak.*
*.swp
__pycache__/
.venv/

# install backups (install.sh creates .bak.<epoch> when replacing existing files)
*.bak.[0-9]*

# NOTE: .claude/ is tracked on purpose — pulse ships its own AI context so a
# fresh clone on a new laptop already has CLAUDE.md available to Claude Code.
# (This overrides the user's global rule about not committing .claude/.)
