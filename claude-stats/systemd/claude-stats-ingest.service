[Unit]
Description=claude-stats: nightly ingest (ccusage daily + sessions + caveman + cleanup)

[Service]
Type=oneshot
# Node comes from nvm, whose version dir changes on every upgrade (a pinned
# %h/.nvm/versions/node/vX path 127s the moment nvm bumps node). Source nvm.sh
# at runtime instead: it reads ~/.nvm/alias/default and prepends that node to
# PATH, so this unit follows the default alias with no edits across upgrades.
# NVM_DIR is set via Environment (systemd would otherwise swallow a $VAR in
# ExecStart); %h is inlined as a literal path in each command.
Environment=NVM_DIR=%h/.nvm
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# ingest-daily depends on npx/network/ccusage (the fragile step) — prefix with
# '-' so its failure can't abort the chain and freeze the local-only sessions
# + cleanup steps (that masking was the original silent-failure bug).
ExecStart=-/usr/bin/bash -c '. %h/.nvm/nvm.sh >/dev/null 2>&1; exec %h/Documents/claude-stats/bin/ingest-daily.sh'
ExecStart=/usr/bin/bash -c '. %h/.nvm/nvm.sh >/dev/null 2>&1; exec %h/Documents/claude-stats/bin/ingest-sessions.py'
# caveman history is tiny + local-only; '-' prefix keeps a malformed line or a
# plugin format change from blocking the retention cleanup that follows.
ExecStart=-/usr/bin/bash -c '. %h/.nvm/nvm.sh >/dev/null 2>&1; exec %h/Documents/claude-stats/bin/ingest-caveman.sh'
ExecStart=/usr/bin/bash -c '. %h/.nvm/nvm.sh >/dev/null 2>&1; exec %h/Documents/claude-stats/bin/cleanup-old.sh'
Nice=15
IOSchedulingClass=idle
